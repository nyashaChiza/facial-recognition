SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Only needed when exposing the dev server through a tunnel (e.g. ngrok),
# for Django's CSRF check to trust the tunnel's origin:
# CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app
CSRF_TRUSTED_ORIGINS=

# Optional: a Sentry DSN for error tracking. Leave empty to disable - the
# app runs fine without it.
SENTRY_DSN=
